# Copy this file to .env. Choose one configuration and save before the next task chat request.
# Use the full OpenAI-compatible Chat Completions endpoint.

# Use a local Codex CLI already signed in with ChatGPT:
# LSM_TASK_PROVIDER=codex
# LSM_TASK_CODEX_BIN=/absolute/path/to/codex
# LSM_TASK_CODEX_MODEL=gpt-6.2-sol

# OpenAI using an existing OPENAI_API_KEY in your local environment:
# OPENAI_MODEL=replace-with-model-id
# OPENAI_API_KEY=replace-with-key

# Other external providers (HTTPS):
# LSM_TASK_LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
# LSM_TASK_LLM_MODEL=replace-with-model-id
# LSM_TASK_LLM_KEY=replace-with-key

# Local OpenAI-compatible runtime, e.g. Ollama:
# LSM_TASK_LLM_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# LSM_TASK_LLM_MODEL=replace-with-installed-model
# LSM_TASK_LLM_KEY=replace-if-your-local-server-requires-a-key
